# Copy to backend/.env or export before running the API.
JOBRADAR_ENV=development
JOBRADAR_DATABASE_URL=sqlite+pysqlite:///./jobradar.db
# Supabase Postgres example:
# JOBRADAR_DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
JOBRADAR_SECRET=change-me-before-production-use-a-long-random-string
JOBRADAR_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JOBRADAR_SAMPLE_SOURCE=true
JOBRADAR_CRAWL_INTERVAL_MINUTES=180
JOBRADAR_SCHEDULER=true
JOBRADAR_STORAGE_DIR=./storage
JOBRADAR_PUBLIC_API_URL=http://localhost:8000

# Email. Leave the key empty to keep messages in the in-app outbox.
JOBRADAR_RESEND_API_KEY=
JOBRADAR_EMAIL_FROM=

# CV storage. Leave empty to store files on disk.
JOBRADAR_SUPABASE_URL=
JOBRADAR_SUPABASE_SERVICE_ROLE_KEY=
JOBRADAR_SUPABASE_BUCKET=cvs

# Optional second pass when the HTTP fetch is blocked. No stealth, no captcha solving.
JOBRADAR_PLAYWRIGHT=false
JOBRADAR_CHROME_PATH=
